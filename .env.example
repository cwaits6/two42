# Supabase - Get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Resend - Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key-here

# Google Maps - Get from https://console.cloud.google.com/ (Places API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-api-key-here

# App Config
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Org slug sent as the x-two42-org header so anonymous visitors resolve the
# right tenant (see docs/security/tenancy-model.md). Defaults to 'default',
# which matches the org seeded by the migrations. It must match a real
# organizations.slug — if it matches nothing, the anonymous /join page
# reports that join requests are unavailable (fail-closed, by design).
# NEXT_PUBLIC_ORG_SLUG=default

# Observability (optional) — OpenTelemetry tracing, see instrumentation.ts.
# Unset (the default) disables OTel entirely: nothing is loaded, no spans are
# recorded. Set the endpoint to any OTLP/HTTP receiver (an OpenTelemetry
# Collector, or a backend's OTLP ingest) — no vendor is hardcoded in app code.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional auth/headers for the receiver, comma-separated key=value pairs:
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer your-token
# Optional service-name override (defaults to the package.json name):
# OTEL_SERVICE_NAME=two42

# Serving signups
# Secret for HMAC-signed email action links (generate: openssl rand -hex 32)
SERVING_LINK_SECRET=change-me
# Default email link behavior: 'signed' (act without login) or 'login'
# (require sign-in). The admin Site Settings toggle overrides this.
# SERVING_LINK_MODE=signed

# Branding — OVERRIDDEN PER-ORG. Since CWA-10 Phase 3, live values come from
# the organizations.branding column (display_name, logo_url, accent,
# reply_to); this var is only the last-resort default used when that row is
# empty or unreadable.
# NEXT_PUBLIC_APP_NAME=two42            # ← branding.display_name wins

# Branding — STILL PLATFORM-WIDE. No branding key overrides any of these.
# NEXT_PUBLIC_APP_DESCRIPTION=A welcoming community of faith, growing together in God's Word.
# NEXT_PUBLIC_APP_TAGLINE=To be the body of Christ through fellowship, discipleship and the faithful study of the Word of God.
# NEXT_PUBLIC_LOGO_MONOGRAM=42
# The sending address is deliberately NOT per-org: SPF/DKIM are configured for
# this domain, so From: never varies by tenant. Only the display name (from
# branding.display_name) and Reply-To (branding.reply_to) do.
# NEXT_PUBLIC_EMAIL_FROM=two42 <noreply@incouragers.org>

# Theme Color fallbacks (all optional — defaults to the two42 clay palette).
# Only PRIMARY is per-org: branding.accent overrides NEXT_PUBLIC_COLOR_PRIMARY.
# Note the name collision — branding.accent does NOT touch COLOR_ACCENT
# (Marigold), which stays platform-wide along with the other four below.
# NEXT_PUBLIC_COLOR_PRIMARY=#B85C38     # ← branding.accent wins
# NEXT_PUBLIC_COLOR_PRIMARY_LIGHT=#C97A54
# NEXT_PUBLIC_COLOR_ACCENT=#E8A33D
# NEXT_PUBLIC_COLOR_WARM=#F3E7D9
# NEXT_PUBLIC_COLOR_BG_LIGHT=#FAEBC2
# NEXT_PUBLIC_COLOR_BG_MUTED=#E8DECF
