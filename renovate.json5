{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>cwaits6/renovate-config"
  ],
  "lockFileMaintenance": {
    "automergeSchedule": ["at any time"]
  },
  // renovate-lockfile.yml commits database.types.ts (and package-lock.json)
  // to Renovate branches through the GitHub API, so the commit is signed and
  // authored by the App's bot user. Renovate compares commit author emails
  // against gitAuthor + this list to decide whether a branch was hand-edited;
  // an unlisted email stops rebasing and automerge.
  "gitIgnoredAuthors": [
    "269082166+cwaits6-release-bot[bot]@users.noreply.github.com"
  ],
  "packageRules": [
    // nosemgrep: package_managers.renovate.renovate-missing-minimum-release-age
    // minimumReleaseAge is inherited from local>cwaits6/renovate-config.
    //
    // An in-range update to an `overrides` entry is a lockfile-only update,
    // which Renovate applies with `npm install <name>@<version>`. npm rejects
    // that (EOVERRIDE) for any name that has an override, so the lockfile
    // step fails and the PR ships with package-lock.json out of sync. Bumping
    // the range edits package.json instead, and the plain lockfile regenerate
    // succeeds.
    {
      "description": "Bump override ranges in package.json instead of lockfile-only updates npm refuses",
      "matchManagers": ["npm"],
      "matchDepTypes": ["overrides"],
      "rangeStrategy": "bump"
    },
    // nosemgrep: package_managers.renovate.renovate-missing-minimum-release-age
    // minimumReleaseAge is inherited from local>cwaits6/renovate-config.
    {
      "description": "Keep ESLint on v9 until eslint-plugin-react supports ESLint 10",
      "matchPackageNames": ["eslint"],
      "allowedVersions": "<10.0.0"
    },
    // nosemgrep: package_managers.renovate.renovate-missing-minimum-release-age
    // minimumReleaseAge is inherited from local>cwaits6/renovate-config.
    {
      "description": "Keep TypeScript on v6 until typescript-eslint supports TS 7 (peer range is <6.1.0 as of typescript-eslint 8.x)",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    },
    // nosemgrep: package_managers.renovate.renovate-missing-minimum-release-age
    // minimumReleaseAge is inherited from local>cwaits6/renovate-config.
    //
    // fullcalendar-v7-guard: watched by .github/workflows/fullcalendar-v7-watch.yml.
    // core/react shipped stable v7 (7.0.2) but daygrid/timegrid/interaction are
    // still beta/rc — mixing majors breaks the build. Hold all @fullcalendar
    // packages on v6 until every one has a stable v7. To enable: bump
    // allowedVersions to "<8.0.0" (or delete this rule). groupName keeps the
    // eventual bump to a single atomic PR across all five packages.
    {
      "description": "Keep FullCalendar on v6 until stable v7 ships for all packages",
      "matchPackageNames": ["@fullcalendar/**"],
      "allowedVersions": "<7.0.0",
      "groupName": "fullcalendar"
    },
    // nosemgrep: package_managers.renovate.renovate-missing-minimum-release-age
    // minimumReleaseAge is inherited from local>cwaits6/renovate-config.
    {
      "description": "Group all non-major npm dependency updates into a single PR",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    }
  ]
}
